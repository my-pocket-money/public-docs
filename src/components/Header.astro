---
import Default from '@astrojs/starlight/components/Header.astro';

// The tab row under the header. A tab is current when the path starts with its
// href; the longest match wins, so API reference beats Relay on /relay/api/.
// Icons are Lucide shapes (ISC licence), drawn at 24px in currentColor.
const tabs = [
	{ label: 'Home', href: '/', exact: true, icon: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/>' },
	{ label: 'Relay', href: '/relay/', icon: '<path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/>' },
	{ label: 'API reference', href: '/relay/api/', icon: '<path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/>' },
	{ label: 'Changelog', href: '/relay/changelog/', icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' },
	{ label: 'Connect', href: '/connect/', icon: '<path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8z"/>' },
];

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const current = tabs
	.filter((tab) => (tab.exact ? path === tab.href : path.startsWith(tab.href)))
	.sort((a, b) => b.href.length - a.href.length)[0];
---

<div class="pm-bar">
	<Default />
</div>
<nav class="pm-tabs print:hidden" aria-label="Sections">
	{
		tabs.map((tab) => (
			<a href={tab.href} aria-current={tab === current ? 'page' : undefined}>
				<svg
					aria-hidden="true"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					set:html={tab.icon}
				/>
				{tab.label}
			</a>
		))
	}
</nav>
